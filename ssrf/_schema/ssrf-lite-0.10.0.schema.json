    "RFChain": {
      "additionalProperties": false,
      "description": "One station's transmitter + receiver + mode, described from that station.\n\nEvery frequency here belongs to the station itself: ``tx`` is what it\nradiates, ``rx`` is what it listens for. A repeater's ``tx`` is therefore\nits output and its ``rx`` is its input.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "station_id": {
