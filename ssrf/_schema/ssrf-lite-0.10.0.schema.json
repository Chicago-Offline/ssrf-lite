{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chicago-Offline/ssrf-lite/main/ssrf/_schema/ssrf-lite-0.10.0.schema.json",
  "title": "SSRF-Lite Reference Document",
  "description": "Schema for SSRF-Lite YAML reference documents (specification v0.10.0). Generated from the Pydantic models in ssrf/models/pydantic_models.py. See ssrf/_schema/SSRF-Lite-Spec.md for prose documentation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URI of the JSON Schema used to validate this document."
    },
    "ssrf_lite_version": {
      "type": "string",
      "const": "0.10.0",
      "description": "SSRF-Lite specification version this file targets."
    },
    "ssrf_lite": {
      "type": "object",
      "description": "Optional non-normative provenance/metadata block.",
      "properties": {
        "version": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "accessed": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "comments": {
      "type": "array",
      "description": "Optional non-normative freeform notes about the document.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "overrides": {
      "type": "object",
      "description": "Field-level patches targeting entities from earlier SSRF roots.",
      "additionalProperties": false,
      "properties": {
        "organizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "stations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "antennas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "rf_chains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "channel_plans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "authorizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "description": "Fields to recursively merge into the target entity."
              }
            }
          }
        }
      }
    },
    "organizations": {
      "items": {
        "$ref": "#/$defs/Organization"
      },
      "title": "Organizations",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "array"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "title": "Stations",
      "type": "array"
    },
    "antennas": {
      "items": {
        "$ref": "#/$defs/Antenna"
      },
      "title": "Antennas",
      "type": "array"
    },
    "rf_chains": {
      "items": {
        "$ref": "#/$defs/RFChain"
      },
      "title": "Rf Chains",
      "type": "array"
    },
    "channel_plans": {
      "items": {
        "$ref": "#/$defs/ChannelPlan"
      },
      "title": "Channel Plans",
      "type": "array"
    },
    "authorizations": {
      "items": {
        "$ref": "#/$defs/Authorization"
      },
      "title": "Authorizations",
      "type": "array"
    },
    "contacts": {
      "items": {
        "$ref": "#/$defs/Contact"
      },
      "title": "Contacts",
      "type": "array"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "title": "Assignments",
      "type": "array"
    }
  },
  "$defs": {
    "Antenna": {
      "additionalProperties": false,
      "description": "Antenna definition with optional gain and height references.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "station_id": {
          "title": "Station Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "gain_dbi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gain Dbi"
        },
        "height_agl_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Agl M"
        },
        "height_amsl_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Amsl M"
        }
      },
      "required": [
        "id",
        "station_id"
      ],
      "title": "Antenna",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "description": "Link between RF resources and an operational use.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rf_chain_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rf Chain Id"
        },
        "channel_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Plan Id"
        },
        "channel_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Name"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "short_name": {
          "anyOf": [
            {
              "maxLength": 6,
              "pattern": "^[A-Z0-9][A-Z0-9 /-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Uppercase label of at most 6 characters for radios with narrow channel displays. House style: amateur = club + band (SARA2M, NSRC7C), GMRS = system + site (NSEAPK, NSEAEV), public safety = agency + function (CPDZ1), plan channels = plan prefix + number (M06, WX1). Omit to let consumers abbreviate the full name automatically.",
          "title": "Short Name"
        },
        "usage": {
          "title": "Usage",
          "type": "string"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "authorization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Id"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "verified": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "usage"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "Authorization": {
      "additionalProperties": false,
      "description": "License or permission data.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "authority",
        "service"
      ],
      "title": "Authorization",
      "type": "object"
    },
    "ChannelPlan": {
      "additionalProperties": false,
      "description": "Collection of reusable channels (e.g., NOAA, marine).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelPlanChannel"
          },
          "title": "Channels",
          "type": "array"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "emissions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Emission"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Emissions permitted on every channel in the plan, most typical first. Saves repeating a service-wide rule -- US CB allows AM, SSB, and FM on all 40 -- on each channel. A channel that declares its own `emission` or `emissions` overrides this.",
          "title": "Emissions"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mode applied to every channel that does not declare its own. Saves repeating a plan-wide tone (NIFOG non-federal channels are 156.7 Hz throughout) on each channel."
        }
      },
      "required": [
        "id",
        "name",
        "channels"
      ],
      "title": "ChannelPlan",
      "type": "object"
    },
    "ChannelPlanChannel": {
      "additionalProperties": false,
      "description": "Single entry in a channel plan.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "anyOf": [
            {
              "maxLength": 6,
              "pattern": "^[A-Z0-9][A-Z0-9 /-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Uppercase label of at most 6 characters for radios with narrow channel displays. House style: amateur = club + band (SARA2M, NSRC7C), GMRS = system + site (NSEAPK, NSEAEV), public safety = agency + function (CPDZ1), plan channels = plan prefix + number (M06, WX1). Omit to let consumers abbreviate the full name automatically.",
          "title": "Short Name"
        },
        "freq_mhz": {
          "description": "Frequency the channel's transmitting station radiates on -- the coast station, repeater output, or broadcaster.",
          "exclusiveMinimum": 0,
          "title": "Freq Mhz",
          "type": "number"
        },
        "rx_freq_mhz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frequency that same station receives on, for duplex channels. Omit for simplex.",
          "title": "Rx Freq Mhz"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "emission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shorthand for a channel permitting a single emission.",
          "title": "Emission"
        },
        "bandwidth_khz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Khz"
        },
        "emissions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Emission"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Every emission this channel permits, most typical first. Use instead of `emission` when more than one is allowed.",
          "title": "Emissions"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Squelch and digital parameters that are part of the channel's definition -- a regulator- or convention-specified CTCSS/DCS tone (NIFOG 156.7 Hz, GMRS travel tone 141.3 Hz) or a shared DMR simplex colour code. Written from the channel's transmitting station like an rf_chain mode: `ctcss_tx_hz` is what it sends, `ctcss_rx_hz` what keys it. A system's rf_chain on the same frequency describes an actual deployment and takes precedence."
        }
      },
      "required": [
        "name",
        "freq_mhz"
      ],
      "title": "ChannelPlanChannel",
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "description": "DMR talkgroup or similar contact directory entry.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "description": "Group, Private, or AllCall",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "default_timeslot": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Timeslot"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "Contact",
      "type": "object"
    },
    "Emission": {
      "additionalProperties": false,
      "description": "One way a channel may be used: an ITU designator plus its parameters.\n\nChannels that permit several incompatible modulations on the same\nfrequency -- US CB allows AM, SSB, and FM on all 40 channels -- carry one\nof these per permitted modulation rather than collapsing to a single\ndesignator.",
      "properties": {
        "emission": {
          "description": "ITU emission designator, e.g. \"8K00A3E\".",
          "title": "Emission",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "AM",
                "APRS",
                "C4FM",
                "CW",
                "DMR",
                "D-STAR",
                "DSD",
                "FM",
                "LSB",
                "NFM",
                "NXDN",
                "PACKET",
                "P25",
                "USB"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mode this emission corresponds to. Set it where the designator is ambiguous -- J3E covers both \"USB\" and \"LSB\".",
          "title": "Mode"
        },
        "bandwidth_khz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Khz"
        },
        "power_w": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Power limit for this emission, where it differs by modulation.",
          "title": "Power W"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "emission"
      ],
      "title": "Emission",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Geographic site with optional latitude/longitude.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Location",
      "type": "object"
    },
    "Mode": {
      "additionalProperties": false,
      "description": "Mode definition capturing analogue or digital specifics.",
      "properties": {
        "type": {
          "description": "Modulation or mode (e.g., FM, DMR)",
          "title": "Type",
          "type": "string"
        },
        "ctcss_tx_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ctcss Tx Hz"
        },
        "ctcss_rx_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ctcss Rx Hz"
        },
        "dcs_tx_code": {
          "anyOf": [
            {
              "enum": [
                "023",
                "025",
                "026",
                "031",
                "032",
                "036",
                "043",
                "047",
                "051",
                "053",
                "054",
                "065",
                "071",
                "072",
                "073",
                "074",
                "114",
                "115",
                "116",
                "122",
                "125",
                "131",
                "132",
                "134",
                "143",
                "145",
                "152",
                "155",
                "156",
                "162",
                "165",
                "172",
                "174",
                "205",
                "212",
                "223",
                "225",
                "226",
                "243",
                "244",
                "245",
                "246",
                "251",
                "252",
                "255",
                "261",
                "263",
                "265",
                "266",
                "271",
                "274",
                "306",
