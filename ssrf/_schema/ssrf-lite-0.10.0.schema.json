    "Verification": {
      "additionalProperties": false,
      "description": "Freshness marker: when, how, and by whom a record was last confirmed.\n\nReference data goes stale. ``verified`` records the most recent positive\nconfirmation that an entry still reflects on-the-air reality, so that\ndownstream tooling can surface records which have not been checked\nwithin a chosen window. It is a provenance claim about the *record*,\nnot an operational fact about the RF resource itself.\n\nScope matters. On an assignment it means \"this operational use is still\ncurrent\"; on an RF chain it means \"these radio parameters still produce\na usable contact\". The two are independent: a tone can be re-confirmed\nwithout re-confirming who is using the channel, and vice versa.",
      "properties": {
        "date": {
          "description": "ISO 8601 calendar date (YYYY-MM-DD) of the confirmation.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "method": {
          "description": "How the record was confirmed: on-air (an operator transmitted through or worked the resource), monitor (received on a receiver or SDR without transmitting, attended or unattended), licensee (owner, trustee, or coordinator confirmed), published (authoritative document or database), survey (deliberate RF survey or measurement).",
          "enum": [
            "on-air",
            "monitor",
            "licensee",
            "published",
            "survey"
          ],
          "title": "Method",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Call sign, unit ID, or handle of whoever confirmed it.",
          "title": "By"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional detail about the confirmation.",
          "title": "Note"
        }
      },
      "required": [
        "date",
        "method"
      ],
      "title": "Verification",
      "type": "object"
    }
